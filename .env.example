# Public (sent to the browser)
# Leave unset on Vercel previews; set to https://beautybook.my in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
TURNSTILE_SECRET_KEY=

# WhatsApp Cloud API, used only to send claim verification codes.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=claim_code

# Google Places API (New), used only by scripts/discover-places.ts.
GOOGLE_PLACES_API_KEY=
